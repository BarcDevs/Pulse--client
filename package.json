{
  "name": "pulse",
  "version": "1.13.3",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "git rev-parse --is-inside-work-tree > /dev/null 2>&1 && git config core.hooksPath .husky || true",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node scripts/dev.mjs",
    "dev:webpack": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node scripts/dev.mjs --webpack",
    "dev:heapdump": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192 --heapsnapshot-near-heap-limit=1\" node scripts/dev.mjs",
    "clear-cache": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "legal:pdf": "node scripts/generate-legal-pdfs.mjs",
    "analyze": "set ANALYZE=true && next build",
    "build": "next build",
    "start": "next start -p $PORT",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@sentry/nextjs": "^10.57.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.96.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "embla-carousel-react": "8.6.0",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.564.0",
    "next": "^16.3.6",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.72.0",
    "react-quill-new": "^3.8.3",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^3.8.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/html2canvas": "^0.5.35",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.6.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^1.0.4"
  }
}
